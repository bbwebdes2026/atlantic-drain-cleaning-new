{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/build-gate.sh\"",
            "if": "Bash(git push *)",
            "timeout": 300,
            "statusMessage": "Running build gate..."
          }
        ]
      }
    ]
  }
}
